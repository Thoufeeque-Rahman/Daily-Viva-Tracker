									"key": "token",
									"value": "{{studentToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/marks/subject-wise?startDate=&endDate=",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"marks",
								"subject-wise"
							],
							"query": [
								{
									"key": "startDate",
									"value": "",
									"description": "Start date range (optional)"
								},
								{
									"key": "endDate",
									"value": "",
									"description": "End date range (optional)"
								}
							]
						},
						"description": "Retrieve performance data aggregated per subject (averages, distribution count, punishments)."
					},
					"response": []
				},
				{
					"name": "Get Evaluated Subjects List",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{studentToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/subjects",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"subjects"
