							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/assignments",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"assignments"
							]
						},
						"description": "Fetch assignments of the student's class, including the student's graded marks."
					},
					"response": []
